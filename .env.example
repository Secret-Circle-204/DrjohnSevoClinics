# ==========================================
# Dr. John Sevo Dental Clinic Application
# Production Environment Variables Template
# ==========================================

# 1. Database Connection (PostgreSQL)
DATABASE_URL=postgres://username:password@127.0.0.1:5432/john_sevo_clinic

# 2. Payload CMS Secret Key
PAYLOAD_SECRET=your_secure_payload_secret_min_32_characters_here

# 3. Public Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://drjohnsevo.com

# 4. Production Email Transport (SMTP / Nodemailer)
# Initial Configuration (e.g. Gmail with App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_clinic_account@gmail.com
# SMTP_PASSWORD=your_app_specific_password
#
# Production Configuration (Custom Domain Email post-migration):
SMTP_HOST=smtp.drjohnsevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@drjohnsevo.com
SMTP_PASSWORD=your_smtp_production_password

# 5. Clinic Email Identities
FROM_EMAIL=info@drjohnsevo.com
FROM_NAME="Dr. John Sevo Dental Clinic"
CLINIC_RECEPTION_EMAIL=reception@drjohnsevo.com
